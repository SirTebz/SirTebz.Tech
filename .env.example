# SirTebz.Tech Environment Configuration

# Base URL for metadata, sitemaps and OpenGraph
NEXT_PUBLIC_SITE_URL=https://sirtebz.tech

# Public Contact Details (Displayed on website)
NEXT_PUBLIC_CONTACT_EMAIL=hello@sirtebz.tech
NEXT_PUBLIC_CONTACT_PHONE="+27 (0) 10 500 8492"

# Server-Side Email Dispatch Provider (Optional - Resend API)
# If left unset, contact form submissions are safely recorded in server logs in development
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=hello@sirtebz.tech
EMAIL_FROM=SirTebz.Tech Contact <inquiries@sirtebz.tech>
